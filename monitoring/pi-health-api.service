[Unit]
Description=Private read-only Raspberry Pi health API
After=pi-health-collector.service tailscaled.service

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/pi-health/api.env
ExecStart=/usr/bin/python3 /opt/pi-health/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=/run/docker.sock /etc/afterglow /opt/nextcloud
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
CPUQuota=10%
MemoryMax=48M

[Install]
WantedBy=multi-user.target
